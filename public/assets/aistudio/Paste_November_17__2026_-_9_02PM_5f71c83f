65.  __name__ == "__main__" nima?
Javob: Bu tekshirish fayl bevosita ishga tushirilgandami yoki import qilinganmi aniqlayd. Bevosita ishga tushirilganda __name__ == "__main__" bo'ladi.
if __name__ == "__main__":
