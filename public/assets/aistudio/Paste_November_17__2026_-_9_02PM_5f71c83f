# eval(input())  # Juda xavfli!
150.  Python'da __index__ metodi nima?
Javob: __index__ — ob'ektni butun son sifatida ishlatish imkonini beradi. Slicing, bin(), hex(), oct() uchun kerak. __int__ dan farqi: __index__ aniq (lossless) konversiya kafolatlaydi.
class Indeks:
    def __init__(self, n): self.n = n
    def __index__(self): return self.n
i = Indeks(2)
lst = [10, 20, 30, 40]
lst[i]       # 30
bin(i)       # "0b10"